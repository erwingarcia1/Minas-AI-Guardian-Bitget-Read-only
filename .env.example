# Copy to .env and fill in. Never commit the real .env file.

# --- Core ---------------------------------------------------------------
# 32-byte urlsafe-base64 key for encrypting customer API credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SENTINEL_MASTER_KEY=

SENTINEL_DB_PATH=./sentinel_data/sentinel.db
SENTINEL_RULES_PATH=./config/rules.yaml
SENTINEL_DASHBOARD_PORT=8390
SENTINEL_METRICS_PORT=9109

# --- Alert channels (configure what you have; routing lives in rules.yaml) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBERS=            # comma-separated E.164 numbers

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_RECIPIENTS=              # comma-separated

# --- Optional -------------------------------------------------------------
# AI triage narratives (also requires triage.enabled: true in rules.yaml)
ANTHROPIC_API_KEY=

# docker-compose postgres service (Phase 2 scale-out)
POSTGRES_PASSWORD=
