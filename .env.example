# Copy to .env and fill in. Never commit the real .env file.

# --- Core ---------------------------------------------------------------
# 32-byte urlsafe-base64 key for encrypting customer API credentials at rest.
# Generate with (python3, not python - Ubuntu ships no `python` binary):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Dependency-free equivalent if the cryptography package is missing:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SENTINEL_MASTER_KEY=

SENTINEL_DB_PATH=./sentinel_data/sentinel.db
SENTINEL_RULES_PATH=./config/rules.yaml
SENTINEL_DASHBOARD_PORT=8390
SENTINEL_METRICS_PORT=9109

# Public URL of the member portal (the TLS front - NOT the raw :8391 bind).
# Production: https://guardian.minastrade.com, once it answers (decision 22;
# docs/deployment.md "The public address"). When set, member SMS alerts end
# with a "Log in now to review: <url>" link; when unset, the SMS says
# "Log in to Minas AI Guardian now to review." with no link.
SENTINEL_PORTAL_URL=
# The reverse proxy in front of the portal and dashboard (decision 22c item
# 6): comma-separated EXACT addresses - no names, no ranges. X-Forwarded-For
# is believed only from these, and the client is its right-most address that
# is not one of them; from any other peer the header is ignored. Blank =
# trust no proxy: the client address is the TCP peer. Under docker compose
# this is pinned to caddy's fixed address in the service environment, which
# beats this file - set it here only for a deployment that is not that one.
SENTINEL_TRUSTED_PROXIES=
# The same, for the ops dashboard alone. Blank until the dashboard moves
# behind the proxy at /admin (decision 22e step 3): until then it believes
# no X-Forwarded-For, not even from the proxy beside it on the network.
SENTINEL_DASHBOARD_TRUSTED_PROXIES=
# #63: the dead-man's switch check-in URL from your uptime monitor. Unset = nothing pushed.
SENTINEL_HEARTBEAT_URL=

# --- Alert channels (configure what you have; routing lives in rules.yaml) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: VA/team group chat id (bot must be added to the group). Routes
# CRITICAL/HIGH to the team group in addition to your personal chat.
TELEGRAM_TEAM_CHAT_ID=

# --- SMS: pick ONE provider. ClickSend is preferred when its creds are set;
# --- Twilio is the fallback. Per-customer SMS uses the same provider.
# ClickSend (username + API key from Dashboard -> API Credentials):
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=                # optional sender ID / number
# comma-separated E.164 numbers for the global ops SMS channel
CLICKSEND_TO_NUMBERS=

# Twilio (fallback if ClickSend is not set):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# comma-separated E.164 numbers (comment kept off the value line: some env
# parsers would otherwise read it as part of the value)
TWILIO_TO_NUMBERS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
# comma-separated
SMTP_RECIPIENTS=

# --- Optional -------------------------------------------------------------
# AI triage narratives (also requires triage.enabled: true in rules.yaml)
ANTHROPIC_API_KEY=

# docker-compose postgres service (Phase 2 scale-out)
POSTGRES_PASSWORD=
