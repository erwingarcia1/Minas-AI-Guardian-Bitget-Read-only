__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.coverage
.env
# `.env` alone does not match `.env.save`, `.env.bak` or `.env.local`, and a
# backup copy of a credential file is still a credential file (#68).
.env.*
!.env.example
*.db
*.db-journal
sentinel_data/
# contains machine-local permission rules (and may embed tokens in rule strings)
.claude/settings.local.json
.DS_Store

*.pem

# mutmut's working copy of the package and the config scripts/mutation-check.sh
# writes; both are regenerated and neither belongs in the repo.
mutants/
setup.cfg

# scripts/mutation-probe.py's mutual exclusion; empty, and only ever locked.
.mutation-probe.lock

# scripts/health-check.sh keeps the output of every run, passes included, so a
# green can be audited without re-running it. Self-pruning after 14 days.
.health-check-logs/

# The owner's drop folder for source material (logos, documents). Originals
# stay here; what the product uses is derived and committed elsewhere (e.g.
# design/brand/ from files/minaslogo.png via scripts/brand-assets.py).
/files/
