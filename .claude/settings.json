{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR:-$PWD}/scripts/ui-parity-reminder.py\"",
            "timeout": 10,
            "statusMessage": "Checking whether a UI surface changed"
          }
        ]
      }
    ]
  }
}
